# Documentation for every variable: docs/configuration.md

# Django settings
# config.settings.dev | config.settings.staging | config.settings.prod
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=
FRONTEND_URL=http://localhost:5173

# Email — brevo | resend
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
RESEND_API_KEY=
VERIFICATION_TEMPLATE_ID=
PASSWORD_RESET_TEMPLATE_ID=
PASSWORD_CHANGED_TEMPLATE_ID=
EMAIL_CHANGE_TEMPLATE_ID=

# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

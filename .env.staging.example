# Reference only this file is never loaded. It records which values staging uses,
# so you can see at a glance which keys belong to which environment.
# Set these in your host's dashboard.
# Documentation for every variable: docs/configuration.md

# Django settings
DJANGO_SETTINGS_MODULE=config.settings.staging
SECRET_KEY=
ALLOWED_HOSTS=api.staging.example.com
CORS_ALLOWED_ORIGINS=https://app.staging.example.com
FRONTEND_URL=https://app.staging.example.com
DOMAIN=staging.example.com

# Database
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_CONN_MAX_AGE=600
DB_SSL_MODE=require
REDIS_URL=
CELERY_BROKER_URL=

# Email — brevo | resend
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
RESEND_API_KEY=
VERIFICATION_TEMPLATE_ID=
PASSWORD_RESET_TEMPLATE_ID=
PASSWORD_CHANGED_TEMPLATE_ID=
EMAIL_CHANGE_TEMPLATE_ID=

# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
